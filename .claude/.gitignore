# Developer Tutor: files that must never be committed by accident.
# This file lives inside .claude/ so it protects you even when you copy only this folder.

# The tutor's private notes, learner list, chat copies and hook logs.
# Only change this line if your repository is PRIVATE and you want the notes backed up
# (the tutor helps you with "python3 .claude/tools/doctor.py share-notes on").
agent-memory/tutor-data/

# Settings and backups for this computer only.
settings.local.json
*.tutor-backup

# Python leftovers.
__pycache__/
*.pyc
